{
  "name": "@beach-tennis-manager/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "drizzle:check": "drizzle-kit check",
    "drizzle:seed": "tsx src/infrastructure/database/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^10.0.1",
    "drizzle-orm": "^0.44.5",
    "fastify": "^5.0.0",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.7",
    "pg": "^8.16.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}